# =============================================================================
# MTB ACTION VIDEO EDITOR - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your API keys
# cp .env.example .env

# -----------------------------------------------------------------------------
# OpenAI API (REQUIRED for MVP)
# -----------------------------------------------------------------------------
# Used for:
# - GPT-4o-mini: Caption generation (analyzing video frames)
# - Whisper: Audio transcription
# - text-embedding-3-small: Text embeddings for search
#
# Get your key at: https://platform.openai.com/api-keys
# Free tier: $5 credit on signup
# Estimated cost: ~$0.009 per minute of video
OPENAI_API_KEY=""

# -----------------------------------------------------------------------------
# Groq API (OPTIONAL for MVP - only needed for agent chat)
# -----------------------------------------------------------------------------
# Used for:
# - Llama 4 Scout: Routing
# - Llama 4 Maverick: Tool use & general conversation
#
# Get your key at: https://console.groq.com/keys
# Free tier: 500,000 tokens/day
# Note: For MVP highlight generation, this is NOT required
#       Only needed if you want to use the chat interface
GROQ_API_KEY=""

# -----------------------------------------------------------------------------
# Opik / Comet ML (OPTIONAL - for observability/monitoring)
# -----------------------------------------------------------------------------
# Used for: LLM call tracing, prompt versioning, monitoring
# Get your key at: https://www.comet.com/signup
# Free tier available
# Note: System works without this, just no monitoring dashboards
COMET_API_KEY=""
COMET_PROJECT="mtb-video-editor"

# -----------------------------------------------------------------------------
# Advanced Settings (usually don't need to change)
# -----------------------------------------------------------------------------
# Frame extraction count (default: 45)
# More frames = better accuracy but slower processing
# MTB_FRAME_COUNT=45

# Min action score threshold (default: 60)
# Higher = only most intense clips
# MTB_MIN_ACTION_SCORE=60

# Enable debug logging
# DEBUG=false
